# Copy to .env for local development:  cp .env.example .env
# .env is gitignored — never commit a real key.
# On Render (or any host), set these in the dashboard's Environment section
# instead of using a file.

# Your free OpenFEC API key: https://api.open.fec.gov/developers/
# Without this the app falls back to the shared DEMO_KEY, which allows only
# 30 requests/hour across every user of it.
FEC_API_KEY=

# Data source. Leave unset (or "live") for real FEC data.
# "mock" serves fictional seed data and shows a red warning banner.
# DATA_PROVIDER=live

# PORT=3000
