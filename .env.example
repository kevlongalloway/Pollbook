# Pollbook configuration
#
# Copy to .env and fill in what you need. `.env` is gitignored.
#
#   node --env-file=.env server.js
#
# On Render, set these in the dashboard instead — the process reads the
# environment either way.
#
# **Nothing here is required to run the site.** With an empty file, Pollbook
# serves every page it serves today: live FEC candidates, campaign money,
# market odds, bills before Congress. Each key below adds a capability, and
# the app says out loud which ones are missing — check `GET /api/meta` and the
# boot log rather than guessing.


# ─────────────────────────────────────────────────────────────────────────
#  Accounts
#  Without DATABASE_URL there are no accounts, and everything else still
#  works. Account routes answer 503 with an explanation rather than failing.
# ─────────────────────────────────────────────────────────────────────────

# Postgres 13 or newer (gen_random_uuid() is built in from 13).
# Render, Neon and Supabase connection strings all work as-is.
DATABASE_URL=postgresql://user:password@host:5432/pollbook

# TLS is inferred from the host: managed providers get TLS without
# certificate verification (their chains are not in Node's root store),
# localhost gets plaintext. Override only if that guess is wrong.
# PGSSLMODE=require

# Per-instance pool size. Small on purpose — the provider's connection
# ceiling is shared across every instance plus any psql session you open to
# debug, and running out is a bad afternoon.
# PG_POOL_MAX=5

# Migrations run at boot, guarded by an advisory lock so parallel instances
# cannot race. Set to 0 to run them yourself with `npm run migrate`.
# RUN_MIGRATIONS=1

# Signs session and unsubscribe tokens. **Required in production** — the
# process refuses to start without it, deliberately: a per-boot random key
# would sign cookies that stop verifying on the next deploy, signing everyone
# out in a way that looks like an auth bug rather than a missing variable.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The canonical origin. Used for absolute OpenGraph URLs, links inside
# outbound email, and — critically — Twilio's webhook signature, which is
# computed over the public URL. Wrong here means every callback fails its
# signature check for reasons that look nothing like a URL problem.
PUBLIC_BASE_URL=https://pollbook.example


# ─────────────────────────────────────────────────────────────────────────
#  Sign in with Google
#  Omit and the Google button simply does not appear.
# ─────────────────────────────────────────────────────────────────────────

# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID
# (type: Web application).
#
# Authorized redirect URI — must match exactly, including the scheme:
#   https://pollbook.example/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ─────────────────────────────────────────────────────────────────────────
#  Sign in with Apple
#  Fiddlier than Google. Four values, all from developer.apple.com.
# ─────────────────────────────────────────────────────────────────────────

# The Services ID (NOT the App ID) — reverse-DNS, e.g. com.nolvek.pollbook.web
APPLE_SERVICE_ID=

# Your 10-character Team ID, top right of the developer portal.
APPLE_TEAM_ID=

# The Key ID of a "Sign in with Apple" key.
APPLE_KEY_ID=

# The contents of the .p8 file for that key.
#
# Paste it with literal \n between lines — dashboards mangle real newlines,
# and the loader un-escapes them. Both forms work; this one survives a copy
# and paste.
#
#   APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"
APPLE_PRIVATE_KEY=

# Return URL to register alongside the Services ID:
#   https://pollbook.example/api/auth/apple/callback
#
# ⚠ Before shipping: register your sending domain with Apple's Private Email
# Relay service (Certificates, Identifiers & Profiles → More → Configure).
# Apple hides most users behind @privaterelay.appleid.com, and mail to those
# addresses is dropped silently unless the sending domain is registered. The
# symptom is Apple users who never receive anything, with no bounce.


# ─────────────────────────────────────────────────────────────────────────
#  Email — Resend
#  With no key, messages print to stdout instead of sending. That is a
#  working local setup, not a stub: the sign-in link is in the log.
# ─────────────────────────────────────────────────────────────────────────

# resend.com → API Keys
RESEND_API_KEY=

# resend.com → Webhooks. Verifies bounce and complaint callbacks (Svix HMAC).
# Without it those callbacks are rejected and hard bounces never suppress.
# Point the webhook at: https://pollbook.example/hooks/resend
RESEND_WEBHOOK_SECRET=

# Must be on a domain verified in Resend, or everything soft-fails.
MAIL_FROM=Pollbook <alerts@pollbook.example>
# MAIL_REPLY_TO=hello@pollbook.example

# **Required to send in production.** CAN-SPAM requires a valid physical
# postal address in every message, and rendering throws without it rather
# than quietly omitting it — the single most common omission in a first
# mailing.
MAILING_ADDRESS=Nolvek Technologies, 123 Example Street, Atlanta, GA 30303


# ─────────────────────────────────────────────────────────────────────────
#  SMS — Twilio
#
#  ⚠ Read this before setting SMS_ENABLED=1.
#
#  Sending political or civic SMS in the US requires A2P 10DLC brand and
#  campaign registration with the carriers. It takes weeks, the Political use
#  case is vetted against your entity type, and a general commercial LLC
#  often cannot register for it — you may need a different campaign class
#  with different throughput and content rules.
#
#  Start that registration well before you need it. It is the long pole, and
#  it is not code. SMS_ENABLED is a second, deliberate switch precisely so
#  that a deploy carrying Twilio credentials does not begin texting people
#  before the registration that legally permits it is finished.
# ─────────────────────────────────────────────────────────────────────────

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# A Messaging Service is strongly preferred over a bare number: it carries
# the 10DLC registration, pools numbers, and keeps a subscriber's thread on
# one sender.
TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_FROM_NUMBER=+15555550100

# Webhooks to configure in Twilio:
#   Delivery status → https://pollbook.example/hooks/twilio/status
#   Incoming messages → https://pollbook.example/hooks/twilio/inbound
#
# Also turn on Advanced Opt-Out so Twilio sends the STOP confirmation; we
# record the opt-out either way and do not double-reply.

# The deliberate second switch. Leave unset until 10DLC is approved.
# SMS_ENABLED=1


# ─────────────────────────────────────────────────────────────────────────
#  Operations
# ─────────────────────────────────────────────────────────────────────────

# Background jobs: deadline reminders, the send queue, retention, odds
# snapshots. Off by default — setting DATABASE_URL should never be the thing
# that starts sending mail. Safe to enable on every instance: each job claims
# its work with FOR UPDATE SKIP LOCKED, so exactly one instance runs it.
# ENABLE_JOBS=1

# The kill switch. Set to 0 and nothing leaves the queue, regardless of what
# else is configured. There is also a runtime one in the portal, but this
# survives a restart.
# SEND_ENABLED=0

# Force a provider regardless of which keys are present.
#   console  print everything to stdout
#   memory   keep it in memory (tests)
#   live     use the real providers
# MESSAGING_PROVIDER=console

# Aggregate counts below this are reported as null rather than rounded — a
# small cell in a metrics table can identify a person.
# METRICS_MIN_CELL=25

# Odds alerts fire on a move this large over this window.
# ODDS_MOVE_THRESHOLD=0.10
# ODDS_LOOKBACK_HOURS=24


# ─────────────────────────────────────────────────────────────────────────
#  Data sources (all pre-existing; the site works without any of them)
# ─────────────────────────────────────────────────────────────────────────

# api.data.gov — free and instant. Without it the shared DEMO_KEY allows
# about 30 requests an hour, which shows up as candidate lists that
# intermittently come back empty.
FEC_API_KEY=

# api.congress.gov — free and instant. Same shared-quota story; the Bills
# page says so itself when it is running on the demo key.
CONGRESS_API_KEY=

# console.groq.com — powers the candidate and bill Q&A panels. Without it
# those panels report that AI answers are unavailable.
GROQ_API_KEY=

# tavily.com — web search behind the Q&A panels. Falls back to Google News
# RSS when absent, which is workable but thinner.
TAVILY_API_KEY=

# mock renders fictional seed data with a red banner across every page.
# Useful offline; never in production.
# DATA_PROVIDER=live
